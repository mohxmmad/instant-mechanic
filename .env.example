DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production-use-strong-random-key
DEBUG=True

POSTGRES_DB=instant_mechanic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# For production (Render) you can either use individual POSTGRES_* vars above
# with the Render Postgres host/user/password, OR set DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# Render Blueprint (render.yaml) auto-provisions Postgres and injects DATABASE_URL

ALLOWED_HOSTS=localhost,127.0.0.1
